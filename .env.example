# Routy — Environment Variables Template
# Copy to .env.local and fill in your values

# Database
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=routy

# AI API (OpenAI-compatible)
AI_BASE_URL=http://127.0.0.1:8045/v1
AI_API_KEY=
AI_MODEL=gemini-3.1-pro
AI_MODEL_LIGHT=gemini-3-flash

# Auth
JWT_SECRET=
